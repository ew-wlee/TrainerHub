/* TrainerHub v0.2 — warm light, hairlines, one black action per surface. */

* {
    outline: none;
}

QWidget {
    color: @text;
    font-family: "@body_font";
    font-size: 12.5px;
}

#Root, QMainWindow, QDialog {
    background-color: @bg;
}

QToolTip {
    background-color: @surface;
    color: @text;
    border: 1px solid @line;
    border-radius: 6px;
    padding: 6px 9px;
}

/* ---------- side rail ---------- */

#SideRail {
    background-color: @bg;
    border-right: 1px solid @line;
}

#NavSection {
    color: @dim;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 1.2px;
    padding: 14px 10px 6px 10px;
}

QPushButton#NavButton {
    text-align: left;
    padding: 0 10px;
    min-height: 34px;
    border: none;
    border-radius: 6px;
    color: @muted;
    background: transparent;
    font-size: 13px;
}

QPushButton#NavButton:hover {
    background-color: @hover;
    color: @text;
}

QPushButton#NavButton[active="true"] {
    background-color: @sunken;
    color: @text;
    font-weight: 600;
}

QPushButton#SourceButton {
    text-align: left;
    padding: 0 10px;
    min-height: 30px;
    border: none;
    border-radius: 6px;
    color: @muted;
    background: transparent;
    font-size: 12.5px;
}

QPushButton#SourceButton:hover {
    background-color: @hover;
    color: @text;
}

QPushButton#SourceButton[active="true"] {
    background-color: @sunken;
    color: @text;
    font-weight: 600;
}

/* ---------- top bar ---------- */

#TopBar {
    background-color: @surface;
    border-bottom: 1px solid @line;
}

#BrandName {
    font-size: 13.5px;
    font-weight: 600;
    letter-spacing: -0.1px;
}

#BrandMark {
    background: transparent;
}

#TopStatus {
    color: @dim;
    font-size: 12px;
}

QLineEdit#SearchBox {
    background-color: @hover;
    border: 1px solid transparent;
    border-radius: 8px;
    padding: 0 10px;
    min-height: 30px;
    max-height: 30px;
    color: @text;
    selection-background-color: @primary;
    selection-color: #FFFFFF;
}

QLineEdit#SearchBox:hover {
    background-color: @sunken;
}

QLineEdit#SearchBox:focus {
    background-color: @surface;
    border-color: @line_strong;
}

QPushButton#IconButton {
    background-color: transparent;
    border: none;
    border-radius: 6px;
    padding: 0;
    min-width: 28px;
    max-width: 28px;
    min-height: 28px;
    max-height: 28px;
    color: @muted;
    font-size: 15px;
}

QPushButton#IconButton:hover {
    background-color: @hover;
    color: @text;
}

/* ---------- buttons ---------- */

QPushButton#PrimaryButton {
    background-color: @primary;
    color: #FFFFFF;
    border: none;
    border-radius: 8px;
    padding: 0 14px;
    min-height: 34px;
    font-weight: 500;
}

QPushButton#PrimaryButton:hover {
    background-color: @primary_deep;
}

QPushButton#PrimaryButton:disabled {
    background-color: @sunken;
    color: @dim;
}

QPushButton#GhostButton {
    background-color: transparent;
    color: @text;
    border: 1px solid @line;
    border-radius: 8px;
    padding: 0 14px;
    min-height: 32px;
}

QPushButton#GhostButton:hover {
    background-color: @hover;
    border-color: @line_strong;
}

QPushButton#GhostButton:disabled {
    color: @dim;
    border-color: @line;
}

QPushButton#DangerButton {
    background-color: transparent;
    color: @danger;
    border: none;
    border-radius: 6px;
    padding: 0 8px;
    min-height: 26px;
}

QPushButton#DangerButton:hover {
    background-color: @danger_soft;
}

QPushButton#LinkButton {
    background: transparent;
    border: none;
    color: @muted;
    padding: 0 6px;
    min-height: 26px;
    text-align: left;
}

QPushButton#LinkButton:hover {
    color: @text;
    background-color: @sunken;
    border-radius: 6px;
}

/* segmented control (downloads) */

#Segmented {
    background-color: @hover;
    border-radius: 8px;
    padding: 2px;
}

QPushButton#SegmentButton {
    border: none;
    border-radius: 6px;
    padding: 0 12px;
    min-height: 26px;
    color: @muted;
    background: transparent;
    font-size: 12px;
}

QPushButton#SegmentButton:hover {
    color: @text;
}

QPushButton#SegmentButton[active="true"] {
    background-color: @surface;
    color: @text;
    font-weight: 600;
}

#DiscoveryToolbar {
    background-color: @surface;
    border-bottom: 1px solid @line;
}

/* ---------- headings ---------- */

#PageTitle {
    font-size: 21px;
    font-weight: 600;
    letter-spacing: -0.3px;
}

#PageSubtitle {
    color: @dim;
    font-size: 12.5px;
}

#SectionTitle {
    font-size: 14px;
    font-weight: 600;
}

#FieldLabel {
    font-size: 12.5px;
    font-weight: 500;
    color: @text;
}

#FieldHint {
    font-size: 11.5px;
    color: @dim;
}

/* ---------- inspector ---------- */

#DetailPanel {
    background-color: @surface;
    border-left: 1px solid @line;
}

#DetailTitle {
    font-size: 15px;
    font-weight: 600;
}

#DetailSource {
    color: @dim;
    font-size: 12px;
}

#DetailNote {
    color: @muted;
    font-size: 12px;
}

#InspectorClose {
    border: none;
    background: transparent;
    color: @dim;
    font-size: 14px;
    border-radius: 5px;
    min-width: 22px;
    max-width: 22px;
    min-height: 22px;
    max-height: 22px;
}

#InspectorClose:hover {
    background-color: @hover;
    color: @text;
}

/* ---------- notices ---------- */

#NoticeBox {
    background-color: @warn_soft;
    border: none;
    border-left: 2px solid @warn;
    border-radius: 0;
    padding: 8px 10px;
    color: @warn;
    font-size: 11.5px;
}

#AccentNotice {
    background-color: @hover;
    border: none;
    border-left: 2px solid @primary;
    border-radius: 0;
    padding: 8px 10px;
    color: @text;
    font-size: 11.5px;
}

/* ---------- settings groups ---------- */

#Card {
    background-color: transparent;
    border: none;
    border-top: 1px solid @line;
    border-radius: 0;
}

#Card QLabel#SectionTitle {
    color: @text;
}

#StatCard {
    background-color: transparent;
    border: 1px solid @line;
    border-radius: 8px;
}

#StatValue {
    font-size: 20px;
    font-weight: 600;
}

#StatLabel {
    color: @dim;
    font-size: 11px;
}

/* ---------- flat rows (library / downloads) ---------- */

#LibraryRow, #DownloadRow {
    background-color: transparent;
    border: none;
    border-bottom: 1px solid @line;
}

#LibraryRow:hover, #DownloadRow:hover {
    background-color: @hover;
}

#RowTitle {
    font-size: 14px;
    font-weight: 500;
    color: @text;
}

#TaskPercent {
    font-family: "@mono_font";
    font-size: 11px;
    color: @dim;
}

#TaskState {
    font-size: 12px;
    color: @muted;
}

#TaskState[level="success"] {
    color: @success;
}

#TaskState[level="danger"] {
    color: @danger;
}

#EmptyGlyph {
    color: @dim;
}

/* ---------- list ---------- */

QListView#TrainerList {
    background-color: transparent;
    border: none;
    padding: 0;
}

QListView#TrainerList::item {
    border: none;
}

/* ---------- inputs ---------- */

QComboBox, QSpinBox, QLineEdit#Field {
    background-color: @hover;
    border: 1px solid transparent;
    border-radius: 8px;
    padding: 0 10px;
    min-height: 30px;
    color: @text;
}

QComboBox:hover, QSpinBox:hover, QLineEdit#Field:hover {
    background-color: @sunken;
}

QComboBox:focus, QSpinBox:focus, QLineEdit#Field:focus {
    background-color: @surface;
    border-color: @line_strong;
}

QComboBox::drop-down {
    border: none;
    width: 22px;
}

QComboBox QAbstractItemView {
    background-color: @surface;
    border: 1px solid @line;
    border-radius: 8px;
    padding: 4px;
    selection-background-color: @sunken;
    selection-color: @text;
    outline: none;
}

QCheckBox {
    spacing: 8px;
    color: @text;
    font-size: 12.5px;
}

QCheckBox::indicator {
    width: 15px;
    height: 15px;
    border-radius: 4px;
    border: 1px solid @line_strong;
    background-color: @surface;
}

QCheckBox::indicator:hover {
    border-color: @primary;
}

QCheckBox::indicator:checked {
    background-color: @primary;
    border-color: @primary;
    image: none;
}

/* ---------- progress ---------- */

QProgressBar {
    background-color: @line;
    border: none;
    border-radius: 0;
    max-height: 2px;
    min-height: 2px;
    text-align: center;
    color: transparent;
}

QProgressBar::chunk {
    background-color: @primary;
}

QProgressBar[state="done"]::chunk {
    background-color: @success;
}

QProgressBar[state="failed"]::chunk {
    background-color: @danger;
}

/* ---------- scrollbars ---------- */

QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 4px 2px 4px 0;
}

QScrollBar::handle:vertical {
    background: @line_strong;
    border-radius: 3px;
    min-height: 28px;
}

QScrollBar::handle:vertical:hover {
    background: @dim;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    height: 0;
    background: none;
}

QScrollBar:horizontal {
    background: transparent;
    height: 8px;
}

QScrollBar::handle:horizontal {
    background: @line_strong;
    border-radius: 3px;
    min-width: 28px;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
    background: none;
}

/* ---------- misc ---------- */

#Divider {
    background-color: @line;
    max-height: 1px;
    min-height: 1px;
    border: none;
}

#EmptyTitle {
    font-size: 14px;
    font-weight: 600;
    color: @text;
}

#EmptyBody {
    font-size: 12.5px;
    color: @dim;
}

QSplitter::handle {
    background-color: transparent;
    width: 1px;
}

QScrollArea {
    border: none;
    background: transparent;
}

QScrollArea > QWidget > QWidget,
QAbstractScrollArea::corner {
    background: transparent;
}

QStackedWidget,
QStackedWidget > QWidget {
    background: transparent;
}

#Toast {
    background-color: @surface;
    border: 1px solid @line;
    border-radius: 9px;
    color: @text;
    padding: 9px 14px;
    font-size: 12px;
}

QMenu {
    background-color: @surface;
    border: 1px solid @line;
    border-radius: 8px;
    padding: 5px;
}

QMenu::item {
    padding: 7px 22px 7px 14px;
    border-radius: 6px;
    color: @text;
}

QMenu::item:selected {
    background-color: @sunken;
}

QMenu::separator {
    height: 1px;
    background-color: @line;
    margin: 4px 8px;
}

QListWidget {
    background-color: transparent;
    border: none;
}

QListWidget::item {
    border-radius: 6px;
    padding: 8px 10px;
    color: @text;
}

QListWidget::item:selected {
    background-color: @sunken;
}

#SideRail { background-color: #F0EFE9; }
#DiscoverySummary { background-color: #E9EEE6; border: 1px solid #DDE5DA; border-radius: 12px; }
#DiscoveryToolbar { background: transparent; border: none; }
QPushButton#NavButton[active="true"] { background-color: #DEE3D9; color: #253D2D; }
QPushButton:focus, QLineEdit:focus, QListView:focus { border: 1px solid #839F88; }
